# ============================================================
# Vagrantfile — Windows Host (VirtualBox)
# Nœuds : k8s2-master (192.168.100.111) + k8s2-worker1 (192.168.100.112)
# !! Ne touche PAS au cluster existant !!
# ============================================================
#
# AVANT de lancer : trouve le nom de ta carte réseau Windows :
#   VBoxManage list bridgedifs | findstr "Name:"
# et remplace la valeur de BRIDGE_ADAPTER ci-dessous.

BRIDGE_ADAPTER = "Intel(R) Ethernet Connection I219-V"

NODES = [
  { name: "k8s2-master",  ip: "192.168.100.111", memory: 2048, cpus: 2 },
  { name: "k8s2-worker1", ip: "192.168.100.112", memory: 1536, cpus: 1 },
]

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = false

  NODES.each do |node|
    config.vm.define node[:name] do |vm|
      vm.vm.hostname = node[:name]

      # Interface 1 : NAT (internet, automatique)
      # Interface 2 : Bridge sur LAN physique
      vm.vm.network "public_network",
        ip: node[:ip],
        bridge: BRIDGE_ADAPTER

      vm.vm.provider "virtualbox" do |vb|
        vb.name   = node[:name]
        vb.memory = node[:memory]
        vb.cpus   = node[:cpus]
        # Autoriser le mode promiscuous pour le trafic Kubernetes (CNI)
        vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
        # Désactiver l'audio et USB inutiles
        vb.customize ["modifyvm", :id, "--audio", "none"]
        vb.customize ["modifyvm", :id, "--usb", "off"]
      end

      # Fixer l'IP statique sur l'interface LAN (eth1 ou enp0s8)
      vm.vm.provision "shell", inline: <<-SHELL
        set -e
        # Trouver l'interface bridge (2ème interface = index 1 après lo)
        IFACE=$(ip -o link show | awk -F': ' '{print $2}' | grep -v lo | sed -n '2p')
        echo "[VAGRANT] Interface LAN détectée : $IFACE"

        # Netplan : IP statique
        cat > /etc/netplan/99-k8s-lan.yaml <<EOF
network:
  version: 2
  ethernets:
    ${IFACE}:
      dhcp4: false
      addresses:
        - #{node[:ip]}/24
EOF
        chmod 600 /etc/netplan/99-k8s-lan.yaml
        netplan apply
        sleep 2

        # Vérification
        ip addr show $IFACE
        echo "[VAGRANT] IP #{node[:ip]} configurée OK"
      SHELL
    end
  end
end
